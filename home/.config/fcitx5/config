# Don't cycle input methods with the trigger key
EnumerateWithTriggerKeys=True
EnumerateSkipFirst=False

# Ctrl+Shift toggles English <-> Vietnamese (like Unikey on Windows)
[Hotkey/TriggerKeys]
0=Control+Shift_L
1=Shift+Control_L
2=Control+Shift_R
3=Shift+Control_R

